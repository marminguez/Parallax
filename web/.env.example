# Public deployment settings (Vercel → Project → Settings → Environment Variables).
# All optional for local development.

# 1 = public site: hides the live local-raster search (no Python or rasters on the host).
NEXT_PUBLIC_PARALLAX_PUBLIC=1

# CARTO basemaps key (free non-commercial use). Without it the keyless legacy URL is used.
NEXT_PUBLIC_CARTO_KEY=

# ArcGIS Location Platform access token with basemap scope (free tier). Without it the legacy
# World Imagery endpoint is used. Restrict the token's referrers to the public domain.
NEXT_PUBLIC_ARCGIS_TOKEN=

# The site asks search engines not to index it unless this is 0.
PARALLAX_NOINDEX=1
